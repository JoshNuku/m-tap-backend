# ==============================================================================
# M-Tap Proximity Switching Backend - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Server & Environment
# ------------------------------------------------------------------------------
PORT=8080
ENV=development                      # "development" | "production" (enables gin.ReleaseMode)

# ------------------------------------------------------------------------------
# 2. Relational Database: PostgreSQL 16 (Neon Serverless PgBouncer Mode)
# ------------------------------------------------------------------------------
# For Local Docker:
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/mtap?sslmode=disable

# For Neon Serverless Production (Connect via PgBouncer Pooler on port 6543):
# DATABASE_URL=postgres://[user]:[password]@[endpoint-pooler].us-east-2.aws.neon.tech:6543/neondb?sslmode=require

# pgxpool Connection Bounds (Optimized for Serverless / PgBouncer):
DB_MAX_CONNS=25                      # Maximum concurrent connections in the pool
DB_MIN_CONNS=5                       # Minimum idle connections retained
DB_MAX_CONN_LIFETIME=30m             # Maximum time a connection may be reused
DB_MAX_CONN_IDLE_TIME=5m             # Maximum time an idle connection can remain open

# ------------------------------------------------------------------------------
# 3. Cache & Task Broker: Redis Cloud (or Local Redis 7)
# ------------------------------------------------------------------------------
# For Local Docker:
REDIS_URL=localhost:6379
REDIS_PASSWORD=

# For Redis Cloud Production:
# REDIS_URL=redis://default:[cloud_password]@[endpoint].redns.redis-cloud.com:[port]
# REDIS_PASSWORD=[cloud_password]

# ------------------------------------------------------------------------------
# 4. Payment Clearing Rail: Paystack API & Webhook Engine
# ------------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=sk_test_mock_secret_key       # Paystack Secret Key (sk_test_... or sk_live_...)
PAYSTACK_PUBLIC_KEY=pk_test_mock_public_key       # Paystack Public Key (pk_test_... or pk_live_...)
PAYSTACK_BASE_URL=https://api.paystack.co         # Paystack Base API URL
PAYSTACK_BYPASS_IP_CHECK=true                     # "false" in prod (enforces IPs 52.31.139.75, 52.49.173.169, 52.214.14.220)
MOCK_PAYSTACK_SUCCESS=true                        # "true" for offline bench tests; "false" for live clearing

# ------------------------------------------------------------------------------
# 5. Proximity SMS Onboarding: Africa's Talking API
# ------------------------------------------------------------------------------
AFRICASTALKING_USERNAME=sandbox                   # "sandbox" or your live production Africa's Talking username
AFRICASTALKING_API_KEY=mock_at_api_key            # Africa's Talking API Key (generated in dashboard)
AFRICASTALKING_SENDER_ID=MTAP                     # Alphanumeric Sender ID (approved by AT in production)
AFRICASTALKING_SANDBOX=true                       # "true" routes to sandbox endpoint; "false" to production
MOCK_SMS=true                                     # "true" logs OTPs to structured slog without dispatching actual SMS
